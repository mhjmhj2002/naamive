{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "naamive://assurance/v1/assistance-proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "proposalId", "blockId", "correlationId", "classification", "alternatives", "recommendation", "confidence", "routingRole", "idempotencyKey"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "proposalId": { "$ref": "naamive://assurance/v1/common#/$defs/uuid" },
    "blockId": { "$ref": "naamive://assurance/v1/common#/$defs/uuid" },
    "correlationId": { "$ref": "naamive://assurance/v1/common#/$defs/uuid" },
    "classification": { "$ref": "naamive://assurance/v1/common#/$defs/classification" },
    "alternatives": { "type": "array", "minItems": 1, "items": { "$ref": "naamive://assurance/v1/common#/$defs/sanitizedObject" } },
    "recommendation": { "$ref": "naamive://assurance/v1/common#/$defs/sanitizedObject" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "routingRole": { "type": "string", "minLength": 1, "maxLength": 128 },
    "humanDecisionRequired": { "type": "boolean" },
    "idempotencyKey": { "type": "string", "minLength": 16, "maxLength": 255 }
  }
}
