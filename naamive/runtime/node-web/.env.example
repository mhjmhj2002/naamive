DATABASE_URL=postgres://naamive:naamive@127.0.0.1:5432/naamive
NAAMIVE_BUILD_ID=development
NAAMIVE_ARTIFACT_STORE_URI=file:///var/lib/naamive-artifacts
NAAMIVE_REPOSITORY_ROOTS=/workspace/projects
NAAMIVE_OPERATOR_ID=local-operator
NAAMIVE_WEB_ORIGIN=http://127.0.0.1:3000
PORT=3000
NAAMIVE_AGENT_TIMEOUT_SECONDS=180
NAAMIVE_AGENT_MAX_RETRIES=0
NAAMIVE_AGENT_HEARTBEAT_SECONDS=30
# Smoke estruturado antes de iniciar descoberta; sucesso é reutilizado por cinco minutos.
NAAMIVE_AGENT_READINESS_TIMEOUT_SECONDS=20
NAAMIVE_AGENT_READINESS_CACHE_SECONDS=300
NAAMIVE_CODEX_COMMAND=codex
NAAMIVE_CODEX_WORKDIR=/var/lib/naamive-workspaces
# Use controlled only in acceptance tests; production invokes the isolated Codex adapter.
NAAMIVE_AGENT_ADAPTER=codex
# Optional authenticated Git smoke; the remote URL must contain this disposable prefix.
NAAMIVE_GIT_SMOKE_PREFIX=naamive-smoke-
