{
  "name": "naamive-node-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "worker": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs src/worker.ts",
    "migrate": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs src/migrate.ts",
    "migrate:validate-043": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs src/migrate-validate-043.ts",
    "reconcile": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs src/reconcile.ts",
    "test": "npm run build && node --env-file-if-exists=.env scripts/run-tests.mjs",
    "test:catalog-publisher:integration": "node scripts/run-catalog-publisher-integration.mjs",
    "git:smoke": "node --env-file-if-exists=.env dist/git-delivery-smoke.js",
    "e2e": "npm run build && node --env-file-if-exists=.env scripts/run-e2e.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bootstrap": "^5.3.8",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
