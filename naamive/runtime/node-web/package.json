{
  "name": "naamive-node-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "migrate": "tsx src/migrate.ts",
    "reconcile": "tsx src/reconcile.ts",
    "test": "node --test dist/**/*.test.js",
    "e2e": "npm run build && node --test dist/*.e2e.test.js"
  },
  "dependencies": { "pg": "^8.16.3" },
  "devDependencies": { "@types/node": "^24.3.0", "@types/pg": "^8.15.5", "tsx": "^4.20.5", "typescript": "^5.9.2" }
}
